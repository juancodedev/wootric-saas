{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wootric-saas-billing-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "LOG_LEVEL": "info",
    "STRIPE_WEBHOOK_SECRET": ""
  },
  "queues": {
    "consumers": [
      {
        "queue": "wootric-billing",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.5
  },
  "env": {
    "production": {
      "name": "wootric-saas-billing-worker"
    },
    "staging": {
      "name": "wootric-saas-billing-worker-staging"
    }
  }
}
