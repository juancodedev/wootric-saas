{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wootric-saas",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"LOG_LEVEL": "info",
		"RATE_LIMIT_WINDOW_SECONDS": "60",
		"RATE_LIMIT_MAX_REQUESTS": "100",
		"STORAGE_BUCKET": "wootric-saas-exports",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": ""
	},
	"kv_namespaces": [
		{
			"binding": "KV_CACHE",
			"id": "8fe4bea7008b49eb97cbcf757b8b2be4"
		},
		{
			"binding": "KV_RATE_LIMIT",
			"id": "6ae62e09cc034ec1b2e9debaf2fed8d8"
		},
		{
			"binding": "KV_SESSIONS",
			"id": "12003232bb80482aa9ac20523e5df5b2"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_EXPORTS",
			"bucket_name": "wootric-saas-exports"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "QUEUE_EXPORTS",
				"queue": "wootric-exports"
			},
			{
				"binding": "QUEUE_SYNC",
				"queue": "wootric-sync"
			},
			{
				"binding": "QUEUE_BILLING",
				"queue": "wootric-billing"
			}
		]
	},
	"services": [
		{
			"binding": "EXPORT_WORKER",
			"service": "wootric-saas-export-worker"
		},
		{
			"binding": "SYNC_WORKER",
			"service": "wootric-saas-sync-worker"
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}